<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    <IfModule mod_headers.c>
        # Static files under /storage are served by Apache directly (not Laravel middleware),
        # so add CORS headers here for frontend download requests.
        SetEnvIf Request_URI "^/storage/" IS_STORAGE_ASSET=1
        Header always set Access-Control-Allow-Origin "*" env=IS_STORAGE_ASSET
        Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS" env=IS_STORAGE_ASSET
        Header always set Access-Control-Allow-Headers "Origin, Range, Accept, Content-Type, Authorization" env=IS_STORAGE_ASSET
        Header always set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" env=IS_STORAGE_ASSET
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
